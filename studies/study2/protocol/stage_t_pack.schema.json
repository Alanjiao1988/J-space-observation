    "annotation_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cell",
        "depth",
        "family",
        "pair_id",
        "pair_semantic_id",
        "role",
        "schema_version",
        "selection_rank",
        "source_line_index",
        "source_row_sha256",
        "template_id"
      ],
      "properties": {
        "cell": {
          "type": "string",
          "minLength": 1
        },
        "depth": {
          "$ref": "#/$defs/compositional_depth"
        },
        "family": {
          "$ref": "#/$defs/family"
        },
        "pair_id": {
          "type": "string",
          "minLength": 1
        },
        "pair_semantic_id": {
          "$ref": "#/$defs/sha256"
        },
        "role": {
          "$ref": "#/$defs/mechanistic_role"
        },
        "schema_version": {
          "const": "jspace-study2-stage-t-annotation-row/v1"
        },
        "selection_rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "source_line_index": {
          "type": "integer",
          "minimum": 0
        },
        "source_row_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "template_id": {
          "$ref": "#/$defs/template_id"
        }
      }
    },
    "attempt_receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "core_manifest_sha256",
        "elapsed_seconds_bucket",
        "image_digest",
        "platform_machine",
        "python_version",
        "pythonhashseed",
        "run_id",
        "schema_version",
        "source_commit",
        "source_tree",
        "torch_imported",
        "weight_load_interlock",
        "weight_path_modules_imported"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1
        },
        "core_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "elapsed_seconds_bucket": {
          "type": "integer",
          "minimum": 0
        },
        "image_digest": {
          "type": "string"
        },
        "platform_machine": {
          "type": "string",
          "minLength": 1
        },
        "python_version": {
          "type": "string",
          "minLength": 1
        },
        "pythonhashseed": {
          "type": "string"
        },
        "run_id": {
          "type": "string"
        },
        "schema_version": {
          "const": "jspace-study2-stage-t-attempt/v1"
        },
        "source_commit": {
          "type": "string"
        },
        "source_tree": {
          "type": "string"
        },
        "torch_imported": {
          "type": "boolean"
        },
        "weight_load_interlock": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Weight entry points replaced by a raising stub before acquisition, so a weight load aborts the run."
        },
        "weight_path_modules_imported": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "Observational: transformers resolves its auto-class registry eagerly, so these module names can appear without any tensor being read."
        }
      }
    },
    "cell_summary": {
      "type": "object",
      "properties": {
        "eligible": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "selected_pair_ids": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "selected_pair_semantic_ids": {
          "type": "array",
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        }
      },
      "required": [
        "eligible",
        "selected",
        "selected_pair_ids",
        "selected_pair_semantic_ids"
      ],
      "additionalProperties": false
    },
    "compositional_depth": {
