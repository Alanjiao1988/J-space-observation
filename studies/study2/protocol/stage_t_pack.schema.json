{
  "$id": "https://github.com/Alanjiao1988/J-space-observation/studies/study2/protocol/stage_t_pack.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study 2 Stage T closed artifact contract",
  "description": "Every Stage T row type is closed: unknown fields, missing fields, and unregistered enum members are rejected. No field in this contract carries a model logit, probability, accuracy, activation, probe, lens, or patching value.",
