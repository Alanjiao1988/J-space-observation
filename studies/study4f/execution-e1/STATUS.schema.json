        "h100_attempted_before_a100": {"const": true},
        "regions_returned_for_h100": {"type": "integer", "minimum": 0},
        "regions_returned_for_a100": {"type": "integer", "minimum": 0},
        "regions_with_a_disqualifying_sku_restriction": {"type": "integer", "minimum": 0},
        "azure_policy_blocks_a_registered_sku_or_region": {"type": "boolean"},
        "quota_and_capacity_reported_separately": {"const": true},
        "eligible_sku_region_pairs_with_sufficient_quota": {"type": "integer", "minimum": 0},
        "family_vcpu_limit_in_every_returned_region": {"type": "integer", "minimum": 0},
        "total_regional_vcpu_limit": {"type": "integer", "minimum": 0},
        "total_regional_vcpu_used": {"type": "integer", "minimum": 0},
        "blocking_dimension": {"type": "string", "minLength": 1},
