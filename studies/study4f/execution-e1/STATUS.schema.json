{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "study4f-e1-status-v1",
  "title": "Study 4F-E1 execution-successor lifecycle router",
  "description": "Restrictive schema for studies/study4f/execution-e1/STATUS.json. Every decision-bearing value is closed: no additional property is admitted anywhere, the lifecycle state must be one of the nine registered E1 terminal states, and every authorization flag, claim-boundary flag and operation counter is pinned to false or zero so a later edit cannot quietly widen what this successor is allowed to have done.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "namespace", "is_authoritative_lifecycle_router",
    "routes_only_this_execution_successor", "lifecycle_state", "terminal",
    "study_kind", "authority", "predecessor", "reached_stage", "not_reached",
    "azure", "authorization_flags", "claim_boundary", "evidence_ledger",
    "shakedown_allowance", "zero_operation_counters", "test_differential",
    "what_this_state_establishes", "next_action_rule", "artifacts"
  ],
  "properties": {
    "schema_version": {"const": "study4f-e1-status-v1"},
    "study_id": {"const": "STUDY4F_E1"},
    "namespace": {"const": "studies/study4f/execution-e1/"},
    "is_authoritative_lifecycle_router": {"const": true},
    "routes_only_this_execution_successor": {"const": true},
    "lifecycle_state": {
      "enum": [
        "STUDY4F_E1_AWAITING_AZURE_GPU_QUOTA_APPROVAL",
        "STUDY4F_E1_QUALIFYING_ACCELERATOR_CAPACITY_UNAVAILABLE",
        "STUDY4F_E1_VISIBLE_GPU_MEMORY_BELOW_REGISTERED_REQUIREMENT",
        "STUDY4F_E1_SHAKEDOWN_FAILED_NO_STUDY_BANK_EXECUTION",
        "STUDY4F_E1_EXECUTION_INTERRUPTED_NO_REINTERPRETATION",
        "STUDY4F_E1_NO_NATURAL_POSITIVE_REFERENCE_QUALIFIED_WITHIN_REGISTERED_LADDER",
        "STUDY4F_E1_RP_DEV_IDENTIFIED_TARGET_NO_COT_HEADROOM",
        "STUDY4F_E1_RP_DEV_IDENTIFIED_TARGET_E0_NOT_OBSERVED",
        "STUDY4F_E1_BEHAVIORAL_FEASIBILITY_SUPPORTED_AWAITING_SEPARATE_CONFIRMATION"
      ]
    },
    "terminal": {"const": true},
    "study_kind": {"const": "resource_only_execution_successor_to_a_published_instrument"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "git_blob", "commit", "tree",
                   "parent_commit", "parent_tree",
                   "published_alone_as_the_first_commit_after_the_predecessor"],
      "properties": {
        "path": {"const": "studies/study4f/prompts/study4f_e1_qualifying_accelerator_execution_authority.md"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parent_commit": {"const": "5fd9602df207e95789263d0f8d52428540f48fb8"},
        "parent_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "published_alone_as_the_first_commit_after_the_predecessor": {"const": true}
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
