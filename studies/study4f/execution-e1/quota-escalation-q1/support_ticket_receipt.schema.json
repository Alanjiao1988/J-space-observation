{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "study4f-e1-q1-support-ticket-receipt-v1",
  "title": "Study 4F-E1-Q1 Azure Support escalation receipt",
  "description": "Restrictive schema for studies/study4f/execution-e1/quota-escalation-q1/support_ticket_receipt.json. It exists to make three things unfalsifiable by a later edit: that at most one support ticket was created, that the request was never enlarged beyond one instance of the registered SKU, and that no full subscription, tenant or support-ticket identifier was committed. Every object is closed and every boundary value is pinned.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "study_id", "namespace", "authority", "authority_section",
    "predecessor", "quota_state_before_the_ticket", "pre_existing_support_ticket",
    "self_service_quota_path", "submitted_support_ticket", "requested_quota",
    "a100_fallback", "azure_resource_counters", "execution_reachability",
    "claim_boundary", "state"
  ],
  "properties": {
    "schema_version": {"const": "study4f-e1-q1-support-ticket-receipt-v1"},
    "study_id": {"const": "STUDY4F_E1_Q1"},
    "namespace": {"const": "studies/study4f/execution-e1/quota-escalation-q1/"},
    "authority_section": {"enum": ["2.1", "2.2", "4.1", "4.2", "4.3"]},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "git_blob", "commit", "tree",
                   "parent_commit", "parent_tree",
                   "published_alone_as_the_first_commit_after_the_predecessor",
                   "newly_published_in_this_invocation",
                   "reused_existing_published_copy"],
      "properties": {
        "path": {"const": "studies/study4f/prompts/study4f_e1_q1_manual_quota_escalation_and_conditional_resume_authority.md"},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "parent_commit": {"const": "1900aa374bf000353580b042b275a730bbad6b1f"},
        "parent_tree": {"const": "a0b5d7304b6d08e55c45f927b048af01ad409126"},
        "published_alone_as_the_first_commit_after_the_predecessor": {"const": true},
        "newly_published_in_this_invocation": {"type": "boolean"},
        "reused_existing_published_copy": {"type": "boolean"}
      }
    },
    "predecessor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["study_id", "commit", "lifecycle_state_at_binding",
                   "failed_self_service_request_id",
                   "failed_self_service_error_code",
                   "predecessor_bytes_modified"],
      "properties": {
        "study_id": {"const": "STUDY4F_E1"},
        "commit": {"const": "1900aa374bf000353580b042b275a730bbad6b1f"},
        "lifecycle_state_at_binding": {"const": "STUDY4F_E1_AWAITING_AZURE_GPU_QUOTA_APPROVAL"},
        "failed_self_service_request_id": {"const": "a6817961-e0f7-4cbe-a1ef-7ac4104e1089"},
        "failed_self_service_error_code": {"const": "QuotaNotAvailableForResource"},
        "predecessor_bytes_modified": {"const": false}
      }
    },
    "quota_state_before_the_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "queried_at", "region", "h100_family",
                   "h100_family_limit", "h100_family_used", "a100_family",
                   "a100_family_limit", "a100_family_used",
                   "total_regional_vcpu_limit", "total_regional_vcpu_used",
                   "quota_already_granted", "mechanisms"],
      "properties": {
        "read_only": {"const": true},
        "queried_at": {"type": "string", "minLength": 1},
        "region": {"const": "australiaeast"},
        "h100_family": {"const": "StandardNCadsH100v5Family"},
        "h100_family_limit": {"type": "integer", "minimum": 0},
        "h100_family_used": {"type": "integer", "minimum": 0},
        "a100_family": {"const": "StandardNCADSA100v4Family"},
        "a100_family_limit": {"type": "integer", "minimum": 0},
        "a100_family_used": {"type": "integer", "minimum": 0},
        "total_regional_vcpu_limit": {"type": "integer", "minimum": 0},
        "total_regional_vcpu_used": {"type": "integer", "minimum": 0},
        "quota_already_granted": {"type": "boolean"},
        "mechanisms": {"type": "array", "items": {"type": "string"}, "minItems": 1}
      }
    },
    "pre_existing_support_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["searched", "mechanism", "matching_non_closed_ticket_found",
                   "tickets_present_before_this_invocation", "branch_taken"],
      "properties": {
        "searched": {"const": true},
        "mechanism": {"type": "string", "minLength": 1},
        "matching_non_closed_ticket_found": {"type": "boolean"},
        "tickets_present_before_this_invocation": {"type": "integer", "minimum": 0},
        "branch_taken": {
          "enum": ["2.1_quota_already_granted",
                   "2.2_an_operator_support_ticket_already_exists",
                   "2.3_no_operator_support_ticket_exists"]
        }
      }
    },
    "self_service_quota_path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exhausted", "additional_microsoft_quota_put_submitted", "reason"],
      "properties": {
        "exhausted": {"const": true},
        "additional_microsoft_quota_put_submitted": {"const": false},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "submitted_support_ticket": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "created_in_this_invocation", "duplicate_created",
                   "api", "programmatic_creation_authorized",
                   "ticket_id_salted_sha256", "ticket_id_salt_material",
                   "ticket_id_last_four", "ticket_id_committed_in_full",
                   "ticket_resource_name", "created_date", "modified_date",
                   "status", "azure_acknowledgement", "severity", "sla_minutes",
                   "sla_expiration_time",
                   "issue_type", "service_display_name",
                   "problem_classification_display_name", "title"],
      "properties": {
        "count": {"const": 1},
        "created_in_this_invocation": {"type": "boolean"},
        "duplicate_created": {"const": false},
        "api": {"type": "string", "minLength": 1},
        "programmatic_creation_authorized": {"type": "boolean"},
        "ticket_id_salted_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "ticket_id_salt_material": {"type": "string", "minLength": 1},
        "ticket_id_last_four": {"type": "string", "pattern": "^[0-9a-zA-Z]{4}$"},
        "ticket_id_committed_in_full": {"const": false},
        "ticket_resource_name": {"type": "string", "minLength": 1},
        "created_date": {"type": "string", "minLength": 1},
        "modified_date": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "azure_acknowledgement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["received", "kind", "is_an_approval", "is_a_denial",
                       "grants_quota", "stated_review_window",
                       "restates_the_requested_region",
                       "restates_the_requested_family",
                       "restates_the_requested_new_limit", "note"],
          "properties": {
            "received": {"type": "boolean"},
            "kind": {"const": "receipt_acknowledgement_only"},
            "is_an_approval": {"const": false},
            "is_a_denial": {"const": false},
            "grants_quota": {"const": false},
            "stated_review_window": {"type": "string", "minLength": 1},
            "restates_the_requested_region": {"type": "string", "minLength": 1},
            "restates_the_requested_family": {"const": "standardNCadsH100v5Family"},
            "restates_the_requested_new_limit": {"const": 40},
            "note": {"type": "string", "minLength": 1}
          }
        },
        "severity": {"type": "string", "minLength": 1},
        "sla_minutes": {"type": "integer", "minimum": 0},
        "sla_expiration_time": {"type": "string", "minLength": 1},
        "issue_type": {"const": "Service and subscription limits (quotas)"},
        "service_display_name": {"const": "Service and subscription limits (quotas)"},
        "problem_classification_display_name": {"const": "Compute-VM (cores-vCPUs) subscription limit increases"},
        "title": {"const": "Manual enablement request: one NC40ads_H100_v5 GPU VM for bounded non-production research"}
      }
    },
    "requested_quota": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subscription_last_four", "subscription_salted_sha256",
                   "subscription_id_committed", "tenant_id_committed", "region",
                   "vm_family", "vm_family_api_name", "requested_new_limit",
                   "requested_instances", "target_sku", "capacity_type",
                   "spot_requested", "more_than_forty_h100_vcpus_requested",
                   "multiple_instances_requested",
                   "multiple_regions_requested_simultaneously",
                   "another_gpu_family_requested_in_this_ticket"],
      "properties": {
        "subscription_last_four": {"const": "d32e"},
        "subscription_salted_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "subscription_id_committed": {"const": false},
        "tenant_id_committed": {"const": false},
        "region": {"const": "australiaeast"},
        "vm_family": {"const": "Standard NCadsH100v5 Family vCPUs"},
        "vm_family_api_name": {"const": "standardNCadsH100v5Family"},
        "requested_new_limit": {"const": 40},
        "requested_instances": {"const": 1},
        "target_sku": {"const": "Standard_NC40ads_H100_v5"},
        "capacity_type": {"const": "standard on-demand"},
        "spot_requested": {"const": false},
        "more_than_forty_h100_vcpus_requested": {"const": false},
        "multiple_instances_requested": {"const": false},
        "multiple_regions_requested_simultaneously": {"const": false},
        "another_gpu_family_requested_in_this_ticket": {"const": false}
      }
    },
    "a100_fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authorized", "submitted", "reason", "registered_sku",
                   "registered_family", "registered_region",
                   "registered_new_limit", "registered_instances"],
      "properties": {
        "authorized": {"type": "boolean"},
        "submitted": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1},
        "registered_sku": {"const": "Standard_NC24ads_A100_v4"},
        "registered_family": {"const": "Standard NCADSA100v4 Family vCPUs"},
        "registered_region": {"const": "brazilsouth"},
        "registered_new_limit": {"const": 24},
        "registered_instances": {"const": 1}
      }
    },
    "azure_resource_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_groups_created", "vms_provisioned",
                   "deployment_attempts", "billable_accelerators_remaining",
                   "resources_remaining"],
      "patternProperties": {"^.*$": {"const": 0}}
    },
    "execution_reachability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["e1_execution_became_reachable", "qualifying_quota_visible",
                   "conditional_resumption_entered", "reason"],
      "properties": {
        "e1_execution_became_reachable": {"type": "boolean"},
        "qualifying_quota_visible": {"type": "boolean"},
        "conditional_resumption_entered": {"type": "boolean"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["is_a_scientific_result", "claims_azure_capacity_is_available",
                   "claims_azure_capacity_is_unavailable",
                   "claims_azure_is_reviewing_beyond_the_recorded_ticket_status",
                   "claims_any_checkpoint_competence", "claims_an_rp_b_candidate",
                   "claims_j_space_exists", "claims_j_space_is_observable",
                   "claims_j_space_is_unobservable"],
      "patternProperties": {"^.*$": {"const": false}}
    },
    "state": {
      "enum": ["STUDY4F_E1_Q1_AWAITING_AZURE_SUPPORT_DECISION",
               "STUDY4F_E1_Q1_MANUAL_PORTAL_SUBMISSION_REQUIRED",
               "STUDY4F_E1_Q1_BLOCKED_ON_STARTING_STATE_INTEGRITY"]
    }
  }
}
