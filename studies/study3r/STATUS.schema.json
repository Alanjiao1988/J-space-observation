        "frozen": {"const": false},
        "execution_authorized": {"const": false},
        "formal_execution_authorized": {"const": false},
        "repair_authorized": {"const": false},
        "amendment_authorized": {"const": false},
        "second_authoring_session_authorized": {"const": false},
        "successor_study_authorized": {"const": false},
        "model_execution_authorized": {"const": false},
        "protocol_v1_1_authorized": {"const": false},
        "protocol_v2_authorized": {"const": false},
        "study3s_authorized": {"const": false},
        "study3m_authorized": {"const": false},
        "study4_authorized": {"const": false},
        "tokenizer_bank_seed_or_interface_operation_authorized": {"const": false},
        "gpu_or_cloud_operation_authorized": {"const": false},
        "rp_b_selection_authorized": {"const": false},
        "github_actions_run_authorized": {"const": false}
