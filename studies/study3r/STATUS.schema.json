{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alanjiao1988/J-space-observation/studies/study3r/STATUS.schema.json",
  "title": "Study 3R authoritative lifecycle router",
  "description": "Restrictive schema for studies/study3r/STATUS.json. Every decision-bearing value is pinned with a const, an enum or a null type. additionalProperties is false at every level.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "study_id",
    "namespace",
    "is_authoritative_lifecycle_router",
    "lifecycle_state",
    "terminal",
    "active_protocol",
    "closure_authority",
    "governing_review",
    "rejected_candidate",
    "authorization_flags",
    "research_question_answered",
    "scientific_result_recorded",
    "repository_records",
    "evidence_ledger",
    "zero_operation_counters",
    "next_action_rule",
    "closure_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": "study3r-status-v1"
    },
    "study_id": {
      "const": "STUDY3R"
    },
    "namespace": {
      "const": "studies/study3r/"
    },
    "is_authoritative_lifecycle_router": {
      "const": true
