            "MAJOR": {"const": 5},
            "MINOR": {"const": 2}
          }
        },
        "blocking_finding_ids": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["F-01", "F-02", "F-03", "F-04"]}
        },
        "major_finding_ids": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {"enum": ["F-05", "F-06", "F-07", "F-08", "F-09"]}
        },
        "minor_finding_ids": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"enum": ["F-10", "F-11"]}
        },
        "artifact_count": {
          "const": 11
        },
        "artifacts": {
          "type": "array",
          "minItems": 11,
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256", "git_blob"],
            "properties": {
              "path": {"type": "string", "pattern": "^studies/study3r/"},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "git_blob": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
            }
          }
        }
      }
