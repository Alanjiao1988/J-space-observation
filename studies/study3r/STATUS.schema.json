    "next_action_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "requires_a_fresh_explicit_project_level_operator_decision",
        "the_decision_must_be_issued_outside_this_terminal_study3r_authority",
