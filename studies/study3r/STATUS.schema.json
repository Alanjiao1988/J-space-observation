        "sha256": {
          "const": "5daf943cc1a236715e39c29013addfb3e1b34da54b98ffc4f385ea4ace5f3a99"
        },
        "git_blob": {
          "const": "4ffb72895562be28dbb2ad8d77b6c1cb7050502f"
        },
        "commit": {
          "const": "f3935293d29dac6df0277179ebcdf9f5778d304b"
        },
        "parent_commit": {
          "const": "08c01ff4753b98ad0f43843fc49c93fac68c89da"
