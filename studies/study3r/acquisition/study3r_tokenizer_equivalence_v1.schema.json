{
 "$id": "https://study3r.invalid/study3r_tokenizer_equivalence_v1.schema.json",
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "additionalProperties": false,
 "properties": {
  "authority": {
   "const": "studies/study3r/prompts/study3r_protocol_v1_authoring_authority.md"
  },
  "comparisons": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "arm_id": {
      "enum": [
       "W1_RAW_DIRECT",
       "W2_ROLE_CANONICAL"
      ],
      "type": "string"
     },
     "differing_tuple_elements": {
      "items": {
       "enum": [
        "bytes",
        "token_ids",
        "common_prefix",
        "discriminant_position",
        "answer_surface_token_ids"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "identical_to_reference": {
      "type": "boolean"
     },
     "immutable_revision": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
     },
     "reference_role": {
      "const": "RT"
     },
     "repository_id": {
      "enum": [
       "deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B",
       "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B",
       "deepseek-ai/DeepSeek-R1-Distill-Qwen-14B",
       "deepseek-ai/DeepSeek-R1-Distill-Qwen-32B"
      ],
      "type": "string"
     },
     "role": {
      "enum": [
       "RT",
       "RP_B1",
       "RP_B2",
       "RP_B3"
      ],
      "type": "string"
     }
    },
    "required": [
     "arm_id",
     "differing_tuple_elements",
     "identical_to_reference",
     "immutable_revision",
     "reference_role",
     "repository_id",
     "role"
    ],
    "type": "object"
   },
   "minItems": 8,
   "type": "array"
  },
  "distinct_stratum_count": {
   "maximum": 4,
   "minimum": 1,
   "type": "integer"
  },
  "pooling_rule": {
   "minLength": 40,
   "type": "string"
  },
  "reference_role": {
   "const": "RT"
  },
  "role_to_stratum": {
   "additionalProperties": false,
   "properties": {
    "RP_B1": {
     "pattern": "^STRATUM_[0-9]{2}$",
     "type": "string"
    },
    "RP_B2": {
     "pattern": "^STRATUM_[0-9]{2}$",
     "type": "string"
    },
    "RP_B3": {
     "pattern": "^STRATUM_[0-9]{2}$",
     "type": "string"
    },
    "RT": {
     "pattern": "^STRATUM_[0-9]{2}$",
     "type": "string"
    }
   },
   "required": [
    "RT",
    "RP_B1",
    "RP_B2",
    "RP_B3"
   ],
   "type": "object"
  },
  "schema_version": {
   "const": "study3r-tokenizer-equivalence-v1"
  },
  "strata": {
   "items": {
    "additionalProperties": false,
    "properties": {
     "roles": {
      "items": {
       "enum": [
        "RT",
        "RP_B1",
        "RP_B2",
        "RP_B3"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "signature_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "stratum_id": {
      "pattern": "^STRATUM_[0-9]{2}$",
      "type": "string"
     }
    },
    "required": [
     "roles",
     "signature_sha256",
     "stratum_id"
    ],
    "type": "object"
   },
   "minItems": 1,
   "type": "array"
  },
  "verified_tuple_elements": {
   "maxItems": 5,
   "minItems": 5,
   "prefixItems": [
    {
     "const": "bytes"
    },
    {
     "const": "token_ids"
    },
    {
     "const": "common_prefix"
    },
    {
     "const": "discriminant_position"
    },
    {
     "const": "answer_surface_token_ids"
    }
   ],
   "type": "array"
  }
 },
 "required": [
  "authority",
  "comparisons",
  "distinct_stratum_count",
  "pooling_rule",
  "reference_role",
  "role_to_stratum",
  "schema_version",
  "strata",
  "verified_tuple_elements"
 ],
 "title": "Study 3R tokenizer functional-equivalence record",
 "type": "object"
}
