# Study 3-P0 feasibility pilot image.
#
# Authority: studies/study3/prompts/study3_p0_feasibility_pilot_authority.md
#
# One image serves both stages, so the CPU tokenizer gate and the GPU model
# pilot provably run the same interpreter, the same frozen dependencies and the
# same frozen science code. Which stage runs is a command, not a rebuild.
#
# Section 4 requires the image to be frozen by immutable digest and Python,
# PyTorch, Transformers, tokenizer, CUDA and supporting package versions to be
# pinned before the first tokenizer call. The base image is therefore pinned by
# digest, never by tag alone, and torch is taken from the base image rather than
# reinstalled.
#
# This image performs no model download at build time. Nothing about a
# checkpoint, a tokenizer or a result is baked in. The build cannot see a P0
# outcome, and a P0 outcome cannot change the build.

FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime@sha256:ac7c098a81512e719afa5d2d497f812d7db3498f340a4b819c69cb7b3b257126

LABEL org.opencontainers.image.title="J-space Study 3-P0 feasibility pilot"
LABEL org.opencontainers.image.base.name="pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime"
LABEL org.opencontainers.image.base.digest="sha256:ac7c098a81512e719afa5d2d497f812d7db3498f340a4b819c69cb7b3b257126"
LABEL io.jspace.study="3"
LABEL io.jspace.stage="P0"
LABEL io.jspace.authority-sha256="80efc7ef8bfe5e3b5e5235f530a44730f185187aa52b85945875fe68ef1eda11"
LABEL io.jspace.formal-execution-authorized="false"
LABEL io.jspace.p0-pilot-execution-authorized="true"
LABEL io.jspace.roles="RT=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B@ad9f0ae0864d7fbcd1cd905e3c6c5b069cc8b562; RL=Qwen/Qwen2.5-Math-1.5B@4a83ca6e4526a4f2da3aa259ec36c259f66b2ab2; RI=Qwen/Qwen2.5-Math-1.5B-Instruct@aafeb0fc6f22cbf0eaeed126eff8be45b0360a35"
LABEL io.jspace.rp="excluded; no positive-reference candidate is selected, downloaded, tokenized, loaded or called"
LABEL io.jspace.trust-remote-code="false"
LABEL io.jspace.authentication="microsoft entra managed identity only; no key, SAS or secret is baked, read or printed"
LABEL io.jspace.claim-boundary="a methods-feasibility pilot. It selects no interface, sets no threshold, passes no formal gate, answers no research question, resolves neither OD2 nor UR-22, freezes nothing and produces no evidence-ledger row."

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1 \
    TOKENIZERS_PARALLELISM=false

RUN groupadd --system --gid 10001 jspace \
    && useradd --system --uid 10001 --gid jspace --create-home \
        --home-dir /workspace/runtime/home --shell /usr/sbin/nologin jspace

WORKDIR /workspace

COPY studies/study3/pilot/p0/container/requirements-study3-p0.txt /workspace/
RUN python -m pip install --no-cache-dir \
        -r /workspace/requirements-study3-p0.txt

# The binding scientific inputs. They are byte-protected: the build copies them,
# never rewrites them.
COPY studies/study3/protocol/interface_calibration_rendering_registry_v0_5.json \
     studies/study3/protocol/interface_calibration_protocol_draft.json \
     /workspace/studies/study3/protocol/
COPY studies/study3/prompts/study3_p0_feasibility_pilot_authority.md \
     /workspace/studies/study3/prompts/

# The frozen P0 science.
COPY studies/study3/pilot/p0/ /workspace/studies/study3/pilot/p0/

# Fail the build unless the authority copy inside the image reproduces its
# registered identity and the frozen corpus and protocol reproduce byte-exactly.
# If any one of those is false there is no image.
RUN python - <<'PY' \
    && python /workspace/studies/study3/pilot/p0/p0_freeze_corpus.py --check \
    && python /workspace/studies/study3/pilot/p0/p0_protocol.py --check
import hashlib
import sys

REGISTERED = "80efc7ef8bfe5e3b5e5235f530a44730f185187aa52b85945875fe68ef1eda11"
path = ("/workspace/studies/study3/prompts/"
        "study3_p0_feasibility_pilot_authority.md")
with open(path, "rb") as handle:
    raw = handle.read()
digest = hashlib.sha256(raw).hexdigest()
if digest != REGISTERED:
    sys.exit("[FAIL] authority sha256 %s != registered %s" % (digest, REGISTERED))
if b"\r" in raw:
    sys.exit("[FAIL] the authority copy carries CR; LF only is registered")
print("[OK] authority identity verified inside the image: %s" % digest)
PY

RUN install -d -o jspace -g jspace -m 0700 \
        /workspace/runtime/home \
        /workspace/runtime/results \
        /workspace/runtime/cache \
        /workspace/runtime/cache/tmp \
        /workspace/runtime/pycache \
    && chown -R 0:0 /workspace/studies /workspace/requirements-study3-p0.txt \
    && chmod -R a-w /workspace/studies /workspace/requirements-study3-p0.txt

ENV HOME=/workspace/runtime/home \
    XDG_CACHE_HOME=/workspace/runtime/cache \
    HF_HOME=/workspace/runtime/cache/huggingface \
    TMPDIR=/workspace/runtime/cache/tmp \
    PYTHONPYCACHEPREFIX=/workspace/runtime/pycache \
    RESULTS_DIR=/workspace/runtime/results

USER 10001:10001

# The default mode is the one that cannot touch a model: it re-derives the
# frozen corpus and the protocol from the registry and stops. Neither the
# tokenizer gate nor the model pilot runs by accident.
CMD ["python", "/workspace/studies/study3/pilot/p0/p0_freeze_corpus.py", "--check"]
