# Study 3 P0-R1 generation-2 continuation image.
#
# Authority: studies/study3/prompts/study3_p0_r1_post_ready_transport_exception_safety_authority.md
# over studies/study3/prompts/study3_v0_6_p0_r1_authority.md
#
# The generation-1 image could not have run. Its Container Apps job command was
# /workspace/p0_r1_model_pilot.sh, which is not a path in the image; its entry
# point defaulted SRC to /workspace/src, which exists only when an ACR task
# mounts a checkout and never in a GPU job; and an `az acr run` context mount
# shadows /workspace entirely.
#
# This image fixes that structurally. The immutable source lives at
# /opt/jspace/src, a path no context mount can shadow, and every entry point is
# installed at a stable absolute path under /usr/local/bin. The build fails
# unless the runtime binding module confirms that each of those paths exists and
# is executable.
#
# One image still serves both stages, so the CPU replay gate and the GPU model
# pilot provably run the same interpreter, the same frozen dependencies and the
# same frozen science code. Which stage runs is a command, not a rebuild.
#
# This image performs no model download at build time and bakes in no P0-T or
# P0-R1 result. The build cannot see an outcome, and an outcome cannot change
# the build.

FROM pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime@sha256:ac7c098a81512e719afa5d2d497f812d7db3498f340a4b819c69cb7b3b257126

LABEL org.opencontainers.image.title="J-space Study 3 P0-R1 continuation (generation 2)"
LABEL org.opencontainers.image.base.name="pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime"
LABEL org.opencontainers.image.base.digest="sha256:ac7c098a81512e719afa5d2d497f812d7db3498f340a4b819c69cb7b3b257126"
LABEL io.jspace.study="3"
LABEL io.jspace.stage="P0-R1"
LABEL io.jspace.generation="2"
LABEL io.jspace.authority-sha256="f72292e75ebf128e90c5cd73588786afa11d9f156f37392a9a9200845ddc19d2"
LABEL io.jspace.supplemental-authority-sha256="ffe75ba42c023e959f3beb23927604c3ae72c07fb4b25be346f504c8ea2930de"
LABEL io.jspace.post-ready-authority-sha256="5594e9728e8e4eb14635c34fb4895e65f2a8fa152ff2bffe76aec33a3ea84d18"
LABEL io.jspace.standalone-source-root="/opt/jspace/src"
LABEL io.jspace.model-pilot-entrypoint="/usr/local/bin/p0_r1_model_pilot_v2.sh"
LABEL io.jspace.replay-entrypoint="/usr/local/bin/p0_r1_replay_v2.sh"
LABEL io.jspace.canary-entrypoint="/usr/local/bin/p0_r1_transport_canary_v2.sh"
LABEL io.jspace.depends-on-acr-workspace-mount="false"
LABEL io.jspace.draft-version="draft-v0.6"
LABEL io.jspace.formal-execution-authorized="false"
LABEL io.jspace.p0-r1-pilot-execution-authorized="true"
LABEL io.jspace.p0-r1-pilot-execution-consumed="false"
LABEL io.jspace.roles="RT=deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B@ad9f0ae0864d7fbcd1cd905e3c6c5b069cc8b562; RL=Qwen/Qwen2.5-Math-1.5B@4a83ca6e4526a4f2da3aa259ec36c259f66b2ab2; RI=Qwen/Qwen2.5-Math-1.5B-Instruct@aafeb0fc6f22cbf0eaeed126eff8be45b0360a35"
LABEL io.jspace.scoring-boundary="first-discriminative-token restricted argmax for S2/S3; S1 and S4 unchanged"
LABEL io.jspace.rp="excluded; no positive-reference candidate is selected, downloaded, tokenized, loaded or called"
LABEL io.jspace.trust-remote-code="false"
LABEL io.jspace.authentication="microsoft entra managed identity only; no key, SAS or secret is baked, read or printed"
LABEL io.jspace.claim-boundary="a methods-feasibility continuation. It selects no interface, sets no threshold, passes no formal gate, answers no research question, resolves neither OD2 nor UR-22, freezes nothing and produces no evidence-ledger row."

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    TRANSFORMERS_NO_ADVISORY_WARNINGS=1 \
    TOKENIZERS_PARALLELISM=false \
    P0_R1_SRC=/opt/jspace/src

RUN groupadd --system --gid 10001 jspace \
    && useradd --system --uid 10001 --gid jspace --create-home \
        --home-dir /workspace/runtime/home --shell /usr/sbin/nologin jspace

WORKDIR /opt/jspace

COPY studies/study3/pilot/p0_r1/container/requirements-study3-p0-r1.txt \
     /opt/jspace/requirements-study3-p0-r1.txt
RUN python -m pip install --no-cache-dir \
        -r /opt/jspace/requirements-study3-p0-r1.txt

# The binding scientific inputs, at the standalone root. They are byte-protected:
# the build copies them, never rewrites them.
COPY studies/study3/protocol/interface_calibration_rendering_registry_v0_6.json \
     studies/study3/protocol/interface_calibration_rendering_registry_v0_6.schema.json \
     studies/study3/protocol/interface_calibration_protocol_draft.json \
     /opt/jspace/src/studies/study3/protocol/
COPY studies/study3/prompts/study3_v0_6_p0_r1_authority.md \
     studies/study3/prompts/study3_p0_r1_pre_replay_execution_completion_authority_rev2.md \
     studies/study3/prompts/study3_p0_r1_post_ready_transport_exception_safety_authority.md \
     /opt/jspace/src/studies/study3/prompts/

# The immutable P0-T evidence and the frozen corpus. The replay gate reads them
# and never writes them.
COPY studies/study3/pilot/p0/ /opt/jspace/src/studies/study3/pilot/p0/

# The frozen P0-R1 science, generation 1 and generation 2 together.
COPY studies/study3/pilot/p0_r1/ /opt/jspace/src/studies/study3/pilot/p0_r1/
RUN rm -rf /opt/jspace/src/studies/study3/pilot/p0_r1/results \
    && rm -f /opt/jspace/src/studies/study3/pilot/p0_r1/p0_r1_execution_lock_v2.json

COPY studies/study3/analysis/design_statistics.py \
     studies/study3/analysis/scoring_boundary_v0_6.py \
     /opt/jspace/src/studies/study3/analysis/

COPY studies/study3/pilot/p0_r1/container/requirements-study3-p0-r1.txt \
     /opt/jspace/src/studies/study3/pilot/p0_r1/container/requirements-study3-p0-r1.txt

# Install every entry point at a stable absolute path. The Container Apps job
# command is one of these files, so `job create` names something that exists.
RUN install -m 0755 \
        /opt/jspace/src/studies/study3/pilot/p0_r1/container/p0_r1_replay_v2.sh \
        /usr/local/bin/p0_r1_replay_v2.sh \
    && install -m 0755 \
        /opt/jspace/src/studies/study3/pilot/p0_r1/container/p0_r1_model_pilot_v2.sh \
        /usr/local/bin/p0_r1_model_pilot_v2.sh \
    && install -m 0755 \
        /opt/jspace/src/studies/study3/pilot/p0_r1/container/p0_r1_transport_canary_v2.sh \
        /usr/local/bin/p0_r1_transport_canary_v2.sh

# Fail the build unless the authority copies inside the image reproduce their
# registered identities, the immutable P0-T artifacts reproduce byte-exactly, the
# replay factorization derives with zero tokenizer encodes, and the protocol and
# receipt reproduce from code. If any one of those is false there is no image.
RUN python /opt/jspace/src/studies/study3/pilot/p0_r1/p0_r1_validate.py --image-build \
    && python /opt/jspace/src/studies/study3/pilot/p0_r1/p0_r1_factorization.py --check \
    && python /opt/jspace/src/studies/study3/pilot/p0_r1/p0_r1_protocol.py --check

# Fail the build unless the transport, journal and runtime-binding modules pass
# their own self-checks inside the image. These are model-free by construction.
RUN python /opt/jspace/src/studies/study3/pilot/p0_r1/p0_r1_transport.py --self-check \
    && python /opt/jspace/src/studies/study3/pilot/p0_r1/p0_r1_blob_transport.py \
        --canary --dry-run --attempt gen2-imagebuild-000000000000 \
    && python /opt/jspace/src/studies/study3/pilot/p0_r1/p0_r1_journal.py \
        --self-check

# Fail the build unless the image can invoke its own job command: every bound
# source path present under the standalone root, every entry point present and
# executable, and no result byte anywhere.
RUN python /opt/jspace/src/studies/study3/pilot/p0_r1/container/p0_r1_image_manifest_v2.py

RUN install -d -o jspace -g jspace -m 0700 \
        /workspace/runtime/home \
        /workspace/runtime/results \
        /workspace/runtime/injected \
        /workspace/runtime/cache \
        /workspace/runtime/cache/tmp \
        /workspace/runtime/pycache \
    && chown -R 0:0 /opt/jspace/src \
        /opt/jspace/requirements-study3-p0-r1.txt \
    && chmod -R a-w /opt/jspace/src \
        /opt/jspace/requirements-study3-p0-r1.txt

ENV HOME=/workspace/runtime/home \
    XDG_CACHE_HOME=/workspace/runtime/cache \
    HF_HOME=/workspace/runtime/cache/huggingface \
    TMPDIR=/workspace/runtime/cache/tmp \
    PYTHONPYCACHEPREFIX=/workspace/runtime/pycache \
    RESULTS_DIR=/workspace/runtime/results \
    INJECTED_DIR=/workspace/runtime/injected

USER 10001:10001

# The default mode is the one that cannot touch a model: it replays the
# immutable P0-T evidence with zero encodes and stops. Neither the registered
# replay gate nor the model pilot runs by accident.
CMD ["python", "/opt/jspace/src/studies/study3/pilot/p0_r1/p0_r1_factorization.py", "--check"]
