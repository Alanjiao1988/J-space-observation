# Study 3 P0-R2 corrective closure image, generation 1 revision 2.
#
# This is still a *thin* infrastructure successor and it still changes no
# science: the P0-R1 generation-3 scientific modules are copied in
# byte-identically from the same commit and verified by SHA-256 at runtime
# before they are imported.
#
# What revision 2 adds is the corrective closure itself -- the v2
# governance-chain validator, the v2 host preflight, the hard-kill recovery
# canary, the attempt ledger and the v2 lock generator -- plus the entry point
# that runs the hard-kill canary. Those bytes have to be *in* the image because
# the canary they implement must run inside the VNet against the pinned image;
# supplying them at runtime instead would make the canary prove something about
# an ad-hoc payload rather than about the image.
#
# The base is the same digest-pinned P0-R1 generation-3 image, so the dependency
# closure cannot move underneath the science.
#
# Nothing is fetched from the network during the build. No model weight,
# checkpoint, tokenizer or corpus byte is ever baked into this image.

ARG BASE_IMAGE=acrjspaceobssea0708231738.azurecr.io/j-space-observation-study3-p0-r1@sha256:e1adda95862ea14bf0397f496aa0ef9f7e5918e95b5436b0eb84ee3480d91e4c
FROM ${BASE_IMAGE}

LABEL org.jspace.stage="STUDY3-P0-R2" \
      org.jspace.generation="1" \
      org.jspace.revision="2" \
      org.jspace.kind="infrastructure-successor-corrective-closure" \
      org.jspace.changes-only="host-to-registry submission transport; corrective closure tooling" \
      org.jspace.science="unchanged-p0-r1-generation-3" \
      org.jspace.supersedes="sha256:3d857e54007d12bd943b383db522b913ba627a544b4d31b3e648eef30a65d8e7" \
      org.jspace.terminal-state="STUDY3_P0_R2_EXECUTION_READY_AWAITING_REPLAY_GATE" \
      org.jspace.model-operations-performed="0"

ENV P0_R2_SRC=/opt/jspace/src \
    P0_R2_STAGE=STUDY3-P0-R2 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_INDEX=1

WORKDIR /opt/jspace

# The P0-R1 scientific modules first, so a change to P0-R2 operational bytes
# does not invalidate the layer that carries the science.
COPY src/studies/study3/pilot/p0_r1/ ${P0_R2_SRC}/studies/study3/pilot/p0_r1/
COPY src/studies/study3/pilot/p0_r2/ ${P0_R2_SRC}/studies/study3/pilot/p0_r2/

# The image-to-Git audit manifest travels with the bytes it describes.
COPY src/studies/study3/pilot/p0_r2/p0_r2_image_manifest_v2.json \
     /opt/jspace/p0_r2_image_manifest_v2.json

COPY entrypoints/ /usr/local/bin/

# The P0-R1 base image runs as the unprivileged account uid=10001(jspace).
# Marking the entry points executable needs root, so elevate for exactly that
# one step and hand the privilege straight back. The successor must not quietly
# become a root image.
USER root
RUN chmod 0755 /usr/local/bin/p0_r2_*.sh
USER 10001

ENV PYTHONPATH=${P0_R2_SRC}/studies/study3/pilot/p0_r2:${P0_R2_SRC}/studies/study3/pilot/p0_r1

# Fail the build if the image does not carry exactly the bytes Git holds -- both
# the Python modules under the image root and the entry points flattened into
# /usr/local/bin. A drifted image can therefore never be pushed.
RUN python3 ${P0_R2_SRC}/studies/study3/pilot/p0_r2/p0_r2_image_manifest_v2.py \
        --audit /opt/jspace/p0_r2_image_manifest_v2.json \
        --image-root ${P0_R2_SRC} \
        --install-root /usr/local/bin

# No default command. Every entry point is named explicitly by the caller, so an
# image that is started by accident does nothing at all.
ENTRYPOINT []
CMD ["/usr/local/bin/p0_r2_successor_v2.sh"]
