            "properties": {
              "gate_id": {
                "const": "I4"
              },
              "fail_closed": {
                "const": true
              },
              "authorizes_mechanistic_execution": {
                "const": false
              },
              "part_of_eligibility": {
                "const": true
              },
              "per_interface_not_global": {
                "const": true
