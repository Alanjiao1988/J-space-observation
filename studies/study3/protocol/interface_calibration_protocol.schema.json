          "merely_descriptive",
          "legal_next_state_on_pass",
          "legal_next_state_on_fail",
          "authorizes_mechanistic_execution",
          "fail_closed",
          "no_pooling"
        ],
        "properties": {
          "gate_id": {
            "enum": [
              "I0",
              "I1a",
              "I1b",
              "I2",
              "I3",
              "I4",
              "I5"
            ]
          },
          "authorizes_mechanistic_execution": {
            "const": false,
            "description": "No gate in a draft may authorize mechanistic execution."
          },
          "fail_closed": {
            "const": true
          },
          "no_pooling": {
            "const": true
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "authorizes_mechanistic_execution",
              "fail_closed",
              "gate_id"
            ],
            "properties": {
              "gate_id": {
                "const": "I0"
              },
              "fail_closed": {
                "const": true
              },
              "authorizes_mechanistic_execution": {
                "const": false
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "authorizes_mechanistic_execution",
              "fail_closed",
              "gate_id"
            ],
            "properties": {
              "gate_id": {
                "const": "I1a"
              },
              "fail_closed": {
                "const": true
              },
              "authorizes_mechanistic_execution": {
                "const": false
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "authorizes_mechanistic_execution",
              "fail_closed",
              "gate_id"
            ],
            "properties": {
              "gate_id": {
                "const": "I1b"
              },
              "fail_closed": {
                "const": true
              },
              "authorizes_mechanistic_execution": {
                "const": false
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "authorizes_mechanistic_execution",
              "fail_closed",
              "gate_id"
            ],
            "properties": {
              "gate_id": {
                "const": "I2"
              },
              "fail_closed": {
                "const": true
              },
              "authorizes_mechanistic_execution": {
                "const": false
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "authorizes_mechanistic_execution",
              "fail_closed",
              "gate_id"
            ],
            "properties": {
              "gate_id": {
                "const": "I3"
              },
              "fail_closed": {
                "const": true
              },
              "authorizes_mechanistic_execution": {
                "const": false
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "authorizes_mechanistic_execution",
              "fail_closed",
              "gate_id"
            ],
            "properties": {
              "gate_id": {
                "const": "I4"
              },
              "fail_closed": {
                "const": true
              },
              "authorizes_mechanistic_execution": {
                "const": false
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "accessible_before_authority",
              "authorizes_mechanistic_execution",
              "covered_constructs",
              "fail_closed",
              "gate_id"
            ],
            "properties": {
              "gate_id": {
                "const": "I5"
              },
              "fail_closed": {
                "const": true
              },
              "authorizes_mechanistic_execution": {
                "const": false
              },
              "accessible_before_authority": {
                "const": false
