{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alanjiao1988/J-space-observation/studies/study3/protocol/interface_calibration_protocol.schema.json",
  "title": "Study 3 interface-calibration protocol draft-v0.2",
  "description": "Fail-closed structural schema for a Study 3 interface-calibration protocol DRAFT at version v0.2. It is deliberately impossible to satisfy this schema with a document that declares itself frozen, declares itself execution-authorized, reports any nonzero performed-operation count, introduces an unregistered operation counter, carries a result row or a task-bank row, selects a winning interface, marks S4 selectable, omits gate I4 from the eligibility set, omits any gate from the hierarchy, lets a gate authorize mechanistic execution, makes the confirmation split accessible before authority, omits the positive-reference construct from confirmation coverage, selects a positive reference, marks OD2, OD5 or OD6 resolved, enables pooling as a rescue, or removes the claim ceiling. The schema validates structure and boundaries only; it cannot and does not validate scientific adequacy, which is why the independent methods review is still required.",
  "type": "object",
  "required": [
    "schema_version",
    "state",
    "status",
    "study_identity",
    "operator_review_v0_1",
    "research_question",
    "non_questions",
    "validation_targets",
    "not_applicable_semantics",
    "interface_profiles",
    "admissibility_order",
    "atomic_evaluation_cells",
    "counterbalancing_design",
    "task_strata",
    "bank_construction_policy",
    "checkpoint_roles",
    "positive_reference_candidates",
    "split_lifecycle",
    "gate_hierarchy",
    "gate_truth_table",
    "target_must_pass_i1_i2_analysis",
    "proposed_statistics",
    "operation_boundaries",
    "compute_and_reproducibility_plan",
    "claim_ceiling",
    "prior_study_statements",
    "unresolved_operator_decisions",
    "blocking_decisions",
    "required_next_action",
    "results",
    "bank_rows"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1,
      "pattern": "draft-v0[.]2$"
    },
    "state": {
      "description": "The only state a conforming v0.2 draft may declare.",
      "const": "STUDY3_INTERFACE_CALIBRATION_PROTOCOL_DRAFT_V0_2_COMPLETE_AWAITING_INDEPENDENT_METHODS_REVIEW"
    },
    "status": {
      "type": "object",
      "required": [
        "document_class",
        "frozen",
        "execution_authorized",
        "review_state",
        "authoritative_artifact",
        "note"
      ],
      "additionalProperties": false,
      "properties": {
        "document_class": {
          "const": "design_draft"
        },
        "frozen": {
          "const": false,
          "description": "Rejects frozen=true."
        },
        "execution_authorized": {
          "const": false,
          "description": "Rejects execution_authorized=true."
        },
        "review_state": {
          "const": "awaiting_independent_methods_review"
        },
        "authoritative_artifact": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "study_identity": {
      "type": "object",
      "required": [
        "study_id",
        "name",
        "namespace",
        "draft_version",
        "predecessors",
        "successor_authority",
        "amendment_history"
      ],
      "additionalProperties": false,
      "properties": {
        "study_id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "namespace": {
          "type": "string",
          "minLength": 1
        },
        "draft_version": {
          "const": "draft-v0.2"
        },
        "predecessors": {
          "type": "array",
          "minItems": 1
        },
        "successor_authority": {
          "const": "none",
          "description": "A draft may not name a successor authority."
        },
        "amendment_history": {
          "type": "array",
          "minItems": 2
        }
      }
    },
    "operator_review_v0_1": {
      "type": "object",
      "required": [
        "disposition",
        "record",
        "additive",
        "v0_1_preserved_unedited",
        "v0_1_receipt_retained",
        "classification",
        "defects"
      ],
      "properties": {
        "disposition": {
          "const": "STUDY3_DRAFT_V0_1_REVIEWED_AMENDMENT_REQUIRED_NOT_APPROVED_FOR_FREEZE"
        },
        "record": {
          "type": "string",
          "minLength": 1
        },
        "additive": {
          "const": true
        },
        "v0_1_preserved_unedited": {
          "const": true
        },
        "v0_1_receipt_retained": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "defects": {
          "type": "array",
          "minItems": 10
        }
      }
    },
    "research_question": {
      "type": "object"
    },
    "non_questions": {
      "type": "array",
      "minItems": 1
    },
    "validation_targets": {
      "type": "array",
      "minItems": 1
    },
    "not_applicable_semantics": {
      "type": "string",
      "minLength": 80
    },
    "interface_profiles": {
      "type": "array",
      "minItems": 4,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "family",
          "role_in_panel",
          "prompt_and_rendering_contract",
          "options_visible",
          "labels_visible",
          "scoring_formula",
          "tokenizer_eligibility_rule",
          "output_validity_rule",
          "chat_template_policy_by_role",
          "applicable_gates",
          "transformation_applicability",
          "non_applicable_transformations",
          "selectable_status",
          "selectable_status_reason",
          "projected_operation_counts_if_later_authorized",
          "known_confounds",
          "disqualifying_failures",
          "notes"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^S[1-4]$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "role_in_panel": {
            "type": "string",
            "minLength": 1
          },
          "prompt_and_rendering_contract": {
            "type": "string",
            "minLength": 1
          },
          "options_visible": {
            "type": "boolean"
          },
          "labels_visible": {
            "type": "boolean"
          },
          "scoring_formula": {
            "type": "string",
            "minLength": 1
          },
          "tokenizer_eligibility_rule": {
            "type": "string",
            "minLength": 1
          },
          "output_validity_rule": {
            "type": "string",
            "minLength": 1
          },
          "chat_template_policy_by_role": {
            "type": "object"
          },
          "applicable_gates": {
            "type": "array",
            "minItems": 1
          },
          "transformation_applicability": {
            "type": "object"
          },
          "non_applicable_transformations": {
            "type": "array"
          },
          "selectable_status": {
            "enum": [
              "selectable",
              "selectable_preferred",
              "conditionally_selectable",
              "never_selectable"
            ]
          },
          "selectable_status_reason": {
            "type": "string",
            "minLength": 1
          },
          "projected_operation_counts_if_later_authorized": {
            "type": "object"
          },
          "known_confounds": {
            "type": "array",
            "minItems": 1
          },
          "disqualifying_failures": {
            "type": "array",
            "minItems": 1
          },
          "notes": {
            "type": "array"
          }
        }
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "selectable_status"
            ],
            "properties": {
              "id": {
                "const": "S1"
              },
              "selectable_status": {
                "const": "selectable"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "selectable_status"
            ],
            "properties": {
              "id": {
                "const": "S2"
              },
              "selectable_status": {
                "const": "selectable_preferred"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "selectable_status"
            ],
            "properties": {
              "id": {
                "const": "S3"
              },
              "selectable_status": {
                "const": "conditionally_selectable"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id",
              "selectable_status"
            ],
            "properties": {
              "id": {
                "const": "S4"
              },
              "selectable_status": {
                "const": "never_selectable"
              }
            }
          },
          "description": "S4 must be never_selectable; marking it selectable is rejected here."
        }
      ]
    },
    "admissibility_order": {
      "type": "object",
      "required": [
        "principle",
        "eligibility_rule",
        "gates_required_for_eligibility",
        "i1b_applicability",
        "order",
        "never_selectable",
        "no_data_dependent_ranking",
        "no_winner_this_round",
        "no_winner_this_round_statement",
        "proposed_disposition_only",
        "study_stops_only_when",
        "confirmation_bank_prohibition",
        "what_happens_if_the_highest_ranked_eligible_surface_is_not_s2"
      ],
      "additionalProperties": false,
      "properties": {
        "principle": {
          "type": "string",
          "minLength": 1
        },
        "eligibility_rule": {
          "type": "string",
          "minLength": 1
        },
        "gates_required_for_eligibility": {
          "type": "array",
          "minItems": 6,
          "contains": {
            "const": "I4"
          },
          "description": "I4 must be part of eligibility; omitting it is rejected here."
        },
        "i1b_applicability": {
          "type": "string",
          "minLength": 1
        },
        "order": {
          "type": "array",
          "minItems": 3
        },
        "never_selectable": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "const": "S4"
          }
        },
        "no_data_dependent_ranking": {
          "const": true
        },
        "no_winner_this_round": {
          "const": true,
          "description": "Rejects a selected winner."
        },
        "no_winner_this_round_statement": {
          "const": "No interface is selected in this round."
        },
        "proposed_disposition_only": {
          "const": true
        },
        "study_stops_only_when": {
          "type": "string",
          "minLength": 1
        },
        "confirmation_bank_prohibition": {
          "type": "string",
          "minLength": 1
        },
        "what_happens_if_the_highest_ranked_eligible_surface_is_not_s2": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "atomic_evaluation_cells": {
      "type": "object",
      "required": [
        "sampling_unit",
        "cluster_rule",
        "cell_factors",
        "definition",
        "pooling_prohibitions",
        "descriptive_pooling",
        "no_pooling_rescue"
      ],
      "additionalProperties": false,
      "properties": {
        "sampling_unit": {
          "const": "the base item"
        },
        "cluster_rule": {
          "type": "string",
          "minLength": 1
        },
        "cell_factors": {
          "type": "array",
          "minItems": 8
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "pooling_prohibitions": {
          "type": "array",
          "minItems": 6
        },
        "descriptive_pooling": {
          "type": "string",
          "minLength": 1
        },
        "no_pooling_rescue": {
          "const": true,
          "description": "Rejects enabling pooling as a rescue."
        }
      }
    },
    "counterbalancing_design": {
      "type": "object",
      "required": [
        "problem_in_v0_1",
        "requirement",
        "separated_factors",
        "construction_algorithm",
        "label_alphabets",
        "k6_renderings"
      ],
      "properties": {
        "separated_factors": {
          "type": "array",
          "minItems": 3
        },
        "construction_algorithm": {
          "type": "object",
          "required": [
            "status",
            "inputs",
            "steps",
            "randomness",
            "verification"
          ],
          "properties": {
            "steps": {
              "type": "array",
              "minItems": 5
            },
            "randomness": {
              "const": "none; the construction is a deterministic function of the registered base-item index and draws no seed"
            }
          }
        },
        "label_alphabets": {
          "type": "object",
          "required": [
            "requirement",
            "answer_domain",
            "forbidden_alphabets",
            "permitted_alphabet_examples",
            "label_set_replacement_rule"
          ],
          "properties": {
            "forbidden_alphabets": {
              "type": "array",
              "minItems": 1
            }
          }
        },
        "k6_renderings": {
          "type": "object",
          "required": [
            "count",
            "one_factor_at_a_time",
            "answer_cue",
            "renderings",
            "v0_1_defect"
          ],
          "properties": {
            "count": {
              "const": 3
            },
            "one_factor_at_a_time": {
              "const": true
            },
            "answer_cue": {
              "const": "held constant across all three renderings"
            },
            "renderings": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3
            }
          }
        }
      }
    },
    "task_strata": {
      "type": "array",
      "minItems": 7
    },
    "bank_construction_policy": {
      "type": "object",
      "required": [
        "rows_generated_this_round",
        "seeds_drawn_this_round"
      ],
      "properties": {
        "rows_generated_this_round": {
          "const": 0
        },
        "seeds_drawn_this_round": {
          "const": 0
        }
      }
    },
    "checkpoint_roles": {
      "type": "array",
      "minItems": 6
    },
    "positive_reference_candidates": {
      "type": "object",
      "required": [
        "selection_status",
        "blocking_decision",
        "dossier",
        "circularity_rule",
        "prequalification_stage_proposal"
      ],
      "properties": {
        "selection_status": {
          "const": "NOT SELECTED; candidate dossier only",
          "description": "Rejects a selected positive reference."
        },
        "blocking_decision": {
          "const": "OD2"
        },
        "dossier": {
          "type": "string",
          "minLength": 1
        },
        "circularity_rule": {
          "type": "object",
          "required": [
            "problem",
            "requirement",
            "canonical_interface_status",
            "item_disjointness"
          ]
        }
      }
    },
    "split_lifecycle": {
      "type": "object",
      "required": [
        "splits",
        "ordering",
        "surface_selection",
        "hard_stop_before_confirmation",
        "confirmation_isolation",
        "prevented_failure_modes",
        "cluster_rule"
      ],
      "properties": {
        "confirmation_isolation": {
          "type": "object",
          "required": [
            "covers_every_gate_bearing_construct",
            "explicitly_includes",
            "accessible_before_authority"
          ],
          "properties": {
            "covers_every_gate_bearing_construct": {
              "const": true
            },
            "explicitly_includes": {
              "type": "array",
              "minItems": 3,
              "contains": {
                "const": "gate I4"
              }
            },
            "accessible_before_authority": {
              "const": false,
              "description": "Rejects a confirmation split that is accessible before authority."
            }
          }
        }
      }
    },
    "gate_hierarchy": {
      "type": "array",
      "minItems": 7,
      "items": {
        "type": "object",
        "required": [
          "gate_id",
          "name",
          "question",
          "inputs",
          "model_roles",
          "applicable_profiles",
          "part_of_eligibility",
          "evaluated_per",
          "threshold_logic",
          "what_passes",
          "what_fails",
