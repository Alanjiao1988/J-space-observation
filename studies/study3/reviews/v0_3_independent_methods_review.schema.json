{
  "$id": "study3-v0-3-independent-methods-review.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$comment": "Acceptance as specified is impossible while any BLOCKING or MAJOR methods finding stands.",
      "if": {
        "properties": {
          "disposition": {
            "const": "STUDY3_V0_3_METHODS_REVIEW_ACCEPTED_AS_SPECIFIED"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "new_findings": {
            "items": {
              "properties": {
                "severity": {
                  "enum": [
                    "MINOR"
                  ]
                }
              }
            },
            "type": "array"
          },
          "unresolved_methods_items": {
            "maxItems": 0,
            "type": "array"
          }
        }
      }
    },
    {
      "$comment": "Acceptance as specified requires every inherited BLOCKING item VERIFIED_RESOLVED.",
      "if": {
        "properties": {
          "disposition": {
            "const": "STUDY3_V0_3_METHODS_REVIEW_ACCEPTED_AS_SPECIFIED"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "inherited_finding_adjudications": {
            "items": {
              "if": {
                "properties": {
                  "original_severity": {
                    "const": "BLOCKING"
                  }
                },
                "required": [
                  "original_severity"
                ]
              },
              "then": {
                "properties": {
                  "status": {
                    "const": "VERIFIED_RESOLVED"
                  }
                }
              }
            },
            "type": "array"
          }
        }
      }
    },
    {
      "$comment": "Successor action must match the disposition and may never jump to freeze or execution.",
      "if": {
        "properties": {
          "disposition": {
            "const": "STUDY3_V0_3_METHODS_REVIEW_ACCEPTED_AS_SPECIFIED"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "next_legal_action": {
            "const": "OPERATOR_REVIEW_ADOPTION_AND_OD2_RESOLUTION_ROUND"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "STUDY3_V0_3_METHODS_REVIEW_ACCEPTED_WITH_REQUIRED_CHANGES"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "next_legal_action": {
            "const": "OPERATOR_CONFORMANCE_AMENDMENT_FOR_DRAFT_V0_3_1"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "disposition": {
            "const": "STUDY3_V0_3_METHODS_REVIEW_REJECTED_AMENDMENT_REQUIRED"
          }
        },
        "required": [
          "disposition"
        ]
      },
      "then": {
        "properties": {
          "next_legal_action": {
            "const": "OPERATOR_AMENDMENT_ROUND_FOR_DRAFT_V0_4"
          }
        }
      }
    },
    {
      "$comment": "CORRECTLY_RETAINED_AS_BLOCKING_OPERATOR_DECISION is legal only for UR-22.",
      "properties": {
        "inherited_finding_adjudications": {
          "items": {
            "if": {
              "properties": {
                "status": {
                  "const": "CORRECTLY_RETAINED_AS_BLOCKING_OPERATOR_DECISION"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "finding_id": {
                  "const": "__NEVER__"
                }
              }
            }
          },
          "type": "array"
        },
        "unresolved_item_adjudications": {
          "items": {
            "if": {
              "properties": {
                "status": {
                  "const": "CORRECTLY_RETAINED_AS_BLOCKING_OPERATOR_DECISION"
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "item_id": {
                  "const": "UR-22"
                }
              }
            }
          },
          "type": "array"
        }
      }
    },
    {
      "$comment": "Per-cell power may never be presented as profile-level power without a derivation.",
      "if": {
        "properties": {
          "per_cell_and_joint_power_decisions": {
            "properties": {
              "does_the_protocol_label_per_cell_power_as_overall_power": {
                "const": true
              }
            },
            "required": [
              "does_the_protocol_label_per_cell_power_as_overall_power"
            ]
          }
        },
        "required": [
          "per_cell_and_joint_power_decisions"
        ]
      },
      "then": {
        "properties": {
          "per_cell_and_joint_power_decisions": {
            "properties": {
              "derived_values": {
                "required": [
                  "assumption_stated"
                ]
              }
            },
            "required": [
              "derived_values",
              "decision",
              "blocking_or_not"
            ]
          }
        }
      }
    }
  ],
  "description": "Fail-closed schema for the second bounded independent methods review of the Study 3 interface-calibration protocol. It rejects an unknown disposition or state; a missing, duplicate or extra inherited identifier; a missing mandatory audit answer; a finding without severity, evidence path, field, rationale or consequence; a binding number without a unit and an authority status; a claim that per-cell power is profile-level power without a derivation; a selected interface or positive reference; any non-zero operation counter or true execution or freeze flag; any bank row, seed, result, model output, confirmation access or evidence row; acceptance as specified with an unresolved blocking or major methods item; acceptance as specified with any inherited BLOCKING item not VERIFIED_RESOLVED; misuse of CORRECTLY_RETAINED_AS_BLOCKING_OPERATOR_DECISION outside OD2 and UR-22; and a successor action that jumps directly to freeze or execution.",
