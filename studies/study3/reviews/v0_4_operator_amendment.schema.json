{
  "$id": "study3-v0-4-operator-amendment-record.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "allOf": [
    {
      "$comment": "UR-22 may never be recorded as resolved.",
      "properties": {
        "unresolved_item_dispositions": {
          "items": {
            "if": {
              "properties": {
                "id": {
                  "const": "UR-22"
                }
              },
              "required": [
                "id"
              ]
            },
            "then": {
              "properties": {
                "disposition": {
                  "const": "UNRESOLVED_BLOCKING_OPERATOR_DECISION"
                }
              }
            }
          },
          "type": "array"
        }
      }
    }
  ],
  "description": "Fail-closed schema for the draft-v0.4 operator amendment record. It refuses a missing, duplicate or extra S3MR2 identifier; fewer than the twenty inherited first-review findings or the twenty-two unresolved items; a repair that self-approves instead of deferring to the third independent review; a resolved OD2 or UR-22; a non-zero operation counter; a true authority flag; any result, evidence row, bank row or seed; a successor action that is not a third independent methods review; and any attempt to record the historical narrative count mismatch as dispositive or to propagate eight MAJOR as the structured finding count.",
  "properties": {
    "authority_flags": {
      "additionalProperties": {
        "const": false
      },
      "minProperties": 8,
      "type": "object"
    },
    "bank_rows": {
      "maxItems": 0,
      "type": "array"
    },
    "both_independent_reviews_remain_valid_rejections": {
      "const": true
    },
    "closure_matrix_v0_4": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "const": "PROPOSED_RESOLVED_SUBJECT_TO_THIRD_INDEPENDENT_METHODS_REVIEW"
          },
          "finding_id": {
            "pattern": "^S3MR2-\\d{3}$",
            "type": "string"
          },
          "original_severity": {
            "enum": [
              "BLOCKING",
              "MAJOR",
              "MINOR"
            ]
          },
          "original_title": {
            "minLength": 1,
            "type": "string"
          },
          "repair": {
            "minLength": 1,
            "type": "string"
          },
          "repair_kind": {
            "enum": [
              "method",
              "operator_decision_input"
            ]
          },
          "self_approved": {
            "const": false
          },
          "verification": {
            "minLength": 1,
            "type": "string"
          },
          "where": {
            "items": {
              "minLength": 1,
              "type": "string"
            },
            "minItems": 1,
            "type": "array"
          }
        },
        "required": [
          "finding_id",
          "original_severity",
          "original_title",
          "repair",
          "where",
          "verification",
          "repair_kind",
          "disposition",
          "self_approved"
        ],
        "type": "object"
      },
      "maxItems": 10,
      "minItems": 10,
      "type": "array",
      "uniqueItems": true
    },
    "document_class": {
      "const": "operator_amendment_record"
    },
    "evidence_rows": {
      "maxItems": 0,
      "type": "array"
    },
    "historical_count_mismatch": {
