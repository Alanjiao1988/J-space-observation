        "review_was_not_edited": {
          "const": true
        },
        "status": {
          "const": "NON_DISPOSITIVE_HISTORICAL_NARRATIVE_COUNT_MISMATCH"
        },
        "structured_new_findings": {
          "properties": {
            "BLOCKING": {
              "const": 2
            },
            "MAJOR": {
              "const": 6
            },
            "MINOR": {
              "const": 2
            },
            "total": {
              "const": 10
            }
          },
