{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Alanjiao1988/J-space-observation/docs/phase1_0d_transport_capacity_certificate.schema.json",
  "title": "Phase 1.0D transport capacity certificate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "artifact",
    "schema_version",
    "authority",
    "protected_bytes",
    "source_gate_and_images",
    "old_terminal_state",
    "provider_calls",
    "evidence",
    "mechanical_gates",
    "capacity_gate_passed",
    "terminal_state",
    "certificate_sha256_definition",
    "certificate_payload_sha256"
  ],
  "properties": {
    "artifact": {
      "const": "phase1_0d_transport_capacity_certificate"
    },
    "schema_version": {
      "const": "phase1-0d-transport-capacity-certificate/v1"
    },
    "authority": {
      "type": "object"
    },
    "protected_bytes": {
      "type": "object"
    },
    "source_gate_and_images": {
      "type": "object"
    },
    "old_terminal_state": {
      "type": "object"
    },
    "provider_calls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count",
        "method"
      ],
      "properties": {
        "count": {
          "const": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "evidence": {
      "type": "object"
    },
    "mechanical_gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "gate_id",
          "expected",
          "observed",
          "passed"
        ],
        "properties": {
          "gate_id": {
            "type": "string",
            "minLength": 1
          },
          "expected": {},
          "observed": {},
          "passed": {
            "type": "boolean"
          }
        }
      }
    },
    "capacity_gate_passed": {
      "type": "boolean"
    },
    "terminal_state": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "const": "BLOCKED_ON_SEMANTIC_REVIEW_TRANSPORT_CAPACITY"
        }
      ]
    },
    "certificate_sha256_definition": {
      "type": "string",
      "minLength": 1
    },
    "certificate_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
