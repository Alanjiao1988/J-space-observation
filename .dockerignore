# Git
.git
.gitignore
!.semantic_audit_build_provenance.json

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/

# Secrets and local env
.env
.env.*
infra/azure/variables.env
secrets/
*.pem
*.key

# Results and model artifacts (must not be baked into image)
results/runs/*
!results/runs/.gitkeep
artifacts/
**/all45_*
**/*session_paste*
**/*session-paste*
**/*sessionpaste*
models/
checkpoints/
*.safetensors
*.pt
*.pth
*.bin
*.gguf

# Hugging Face cache
.cache/
huggingface/

# OS / editor
.DS_Store
.vscode/
.idea/

# Docs and CI (not needed at runtime)
.github/
