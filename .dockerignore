# Git
.git
.gitignore
!.semantic_audit_build_provenance.json

# Python caches
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/

# Virtual environments
.venv/
venv/

# Secrets and local env
.env
.env.*
infra/azure/variables.env
secrets/
*.pem
*.key

# Results and model artifacts (must not be baked into image)
results/runs/*
!results/runs/.gitkeep
artifacts/*
# Narrow, deliberate exception: the Phase 1.2H-R1 access image needs the
# committed public seal record that lists the 12 sealed parser-v3-v1 objects by
# name, byte count and SHA-256. It contains no answer value, no span, no offset
# and no case content, and the image verifies it by digest at build time.
# Scoped to this one file so the blanket artifacts/ exclusion keeps protecting
# everything else.
!artifacts/phase1-evaluator-validation/
artifacts/phase1-evaluator-validation/*
!artifacts/phase1-evaluator-validation/track-d1/
artifacts/phase1-evaluator-validation/track-d1/*
!artifacts/phase1-evaluator-validation/track-d1/20260725T160340Z-track-d1-parser-v3-seal/
artifacts/phase1-evaluator-validation/track-d1/20260725T160340Z-track-d1-parser-v3-seal/*
!artifacts/phase1-evaluator-validation/track-d1/20260725T160340Z-track-d1-parser-v3-seal/02_records.jsonl
# Second narrow exception: the Phase 1.0D confirmation image needs Phase 1.0C's
# own generated records, because the disjoint confirmation split is defined
# against the item ids 1.0C actually generated on rather than against a split
# label. Section 4.3 states that every prompt and output in this work package is
# public scientific data; this file carries no private review material and no
# reviewer identity. Scoped to this one file so the blanket artifacts/ exclusion
# keeps protecting everything else.
!artifacts/phase1-headroom-calibration/
artifacts/phase1-headroom-calibration/*
!artifacts/phase1-headroom-calibration/track-b/
artifacts/phase1-headroom-calibration/track-b/*
!artifacts/phase1-headroom-calibration/track-b/20260725T170041Z/
artifacts/phase1-headroom-calibration/track-b/20260725T170041Z/*
!artifacts/phase1-headroom-calibration/track-b/20260725T170041Z/02_records.jsonl
# Third narrow exception: the v2 reviewer image verifies the complete immutable
# v1 gate evidence as a historical parent.  These four public files contain no
# credentials and the v2 build verifies every manifest entry before succeeding.
!artifacts/phase1-0d-semantic-review-gate/
artifacts/phase1-0d-semantic-review-gate/*
!artifacts/phase1-0d-semantic-review-gate/20260803T031343Z/
!artifacts/phase1-0d-semantic-review-gate/20260803T031343Z/00_gate_receipt.json
!artifacts/phase1-0d-semantic-review-gate/20260803T031343Z/01_qualification_console_transcript.txt
!artifacts/phase1-0d-semantic-review-gate/20260803T031343Z/02_smoke_console_transcript.txt
!artifacts/phase1-0d-semantic-review-gate/20260803T031343Z/artifact_manifest.json
**/all45_*
evaluator_sets/
**/locked_inputs.jsonl
**/locked_reference_labels.jsonl
**/locked_case_mapping.json
**/locked_manifest.json
**/reviewer_*_locked*.jsonl
**/arbitration_locked*.jsonl
**/*session_paste*
**/*session-paste*
**/*sessionpaste*
models/
checkpoints/
*.safetensors
*.pt
*.pth
*.bin
*.gguf

# Hugging Face cache
.cache/
huggingface/

# OS / editor
.DS_Store
.vscode/
.idea/

# Docs and CI (not needed at runtime)
.github/
