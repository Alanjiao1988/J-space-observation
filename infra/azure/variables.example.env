# Azure Infrastructure Variables
# Copy this to variables.env and fill in your details

# Azure subscription and resource group
AZURE_SUBSCRIPTION_ID="YOUR_SUBSCRIPTION_ID"
AZURE_RESOURCE_GROUP="jspace-observation-rg"
AZURE_LOCATION="eastus"

# Azure Container Registry
ACR_NAME="jspaceobsacr"
ACR_REGISTRY="${ACR_NAME}.azurecr.io"

# Docker image
IMAGE_NAME="jspace-observation"
IMAGE_TAG="latest"
FULL_IMAGE="${ACR_REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}"

# Storage
AZURE_STORAGE_ACCOUNT="jspacestg"
AZURE_STORAGE_CONTAINER="results"

# Compute
GPU_SKU="Standard_NC4as_T4_v3"  # Single T4 GPU
SPOT_VM=true
TIMEOUT_MINUTES=120

# Model paths
PRIMARY_MODEL="deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B"
BASELINE_MODEL="Qwen/Qwen2.5-Math-1.5B"

# HuggingFace Token (optional, for private models)
HF_TOKEN=""

# Experiment parameters
PHASE0_5_PROMPT_COUNTS="10,25,50"
PHASE0_5_SEQUENCE_LENGTHS="64,128"
PHASE1_TASK_FAMILIES="arithmetic,synthetic_relation"
PHASE1_DEPTHS="1,2,3"
