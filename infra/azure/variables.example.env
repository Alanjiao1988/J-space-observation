# Azure Infrastructure Variables
# Copy this file to variables.env and fill in your local values.
# Do not commit variables.env, credentials, tokens, or secret values.

# Subscription and location
AZURE_SUBSCRIPTION_ID=""
AZURE_RESOURCE_GROUP="rg-jspace-observation"
AZURE_LOCATION="southeastasia"

# Azure Container Registry and image
AZURE_CONTAINER_REGISTRY=""
AZURE_IMAGE_NAME="jspace-observation"
AZURE_IMAGE_TAG="latest"
AZURE_IMAGE="${AZURE_CONTAINER_REGISTRY}.azurecr.io/${AZURE_IMAGE_NAME}:${AZURE_IMAGE_TAG}"

# Azure Container Apps GPU execution
AZURE_CONTAINER_APP_ENV="acaenv-jspace-observation"
AZURE_CONTAINER_APP_JOB="job-jspace-observation"
GPU_WORKLOAD_PROFILE="Consumption-GPU-NC8as-T4"
GPU_WORKLOAD_PROFILE_NAME="gpu-t4"

# Mounted paths inside Azure job containers
HF_HOME="/mnt/models/huggingface"
TRANSFORMERS_CACHE="/mnt/models/huggingface"
RESULTS_DIR="/mnt/results"

# Experiment defaults
PRIMARY_MODEL="deepseek-ai/DeepSeek-R1-Distill-Qwen-1.5B"
BASELINE_MODEL="Qwen/Qwen2.5-Math-1.5B"
PHASE0_5_PROMPT_COUNTS="10,25,50"
PHASE0_5_SEQUENCE_LENGTHS="64,128"
PHASE1_TASK_FAMILIES="arithmetic,synthetic_relation,factual_counterfactual"
PHASE1_DEPTHS="1,2,3"
PHASE1_CONDITIONS="strict_answer_only,visible_cot,r1_style_thinking"

# Optional secret names in Azure; values must be set in Azure, never in git.
HF_TOKEN_SECRET_NAME="hf-token"
