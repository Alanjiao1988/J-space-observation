# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.env.*

# Results and model artifacts
results/runs/*
!results/runs/.gitkeep
models/
checkpoints/
*.safetensors
*.pt
*.pth
*.bin
*.gguf

# OS / editor
.DS_Store
.vscode/
.idea/

# Secrets
*.pem
*.key
secrets/

# Local Azure execution context (resource IDs, generated values; not source)
.azure_*.tmp

# Read-only audit downloads and raw job logs
artifacts/record_audit/
artifacts/semantic_audit/
artifacts/evaluator_validation/

# Parser-v2 locked holdout material must remain outside normal Git paths
evaluator_sets/**/private/
evaluator_sets/**/locked_inputs.jsonl
evaluator_sets/**/locked_reference_labels.jsonl
evaluator_sets/**/locked_case_mapping.json
evaluator_sets/**/locked_manifest.json
evaluator_sets/**/reviewer_*_locked*.jsonl
evaluator_sets/**/arbitration_locked*.jsonl

# Generated only by the checked semantic-audit build preparation command
.semantic_audit_build_provenance.json
